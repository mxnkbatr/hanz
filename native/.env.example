# Fixture catalog + sandbox QPay. Set to 0 only when the Supabase anon key is configured
# and you want live listings / the real `qpay` edge function.
EXPO_PUBLIC_PREVIEW=1

# Same project the web app uses. Publishable anon key only — never the service role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. The web enroll flow reads VITE_SUPABASE_* ; this app reads only EXPO_PUBLIC_*.
