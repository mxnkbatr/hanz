VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Comma-separated admin emails (also add to Supabase admin_allowlist)
VITE_ADMIN_EMAILS=you@example.com
# Public site address, used for Open Graph / canonical URLs in index.html
VITE_SITE_URL=https://hanz.mn

# Cloudinary: cloud name is public; key/secret are only for scripts/upload-cloudinary.mjs
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
